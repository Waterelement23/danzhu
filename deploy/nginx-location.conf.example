# Include inside the existing domain's server block.
# Nginx and danzhu must share the Docker network configured in NGINX_NETWORK.
# Keep the trailing slash: remove /danzhu/ before forwarding to the game server.
location = /danzhu {
    return 308 /danzhu/;
}

location ^~ /danzhu/ {
    proxy_pass http://danzhu:2567/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_buffering off;
}
